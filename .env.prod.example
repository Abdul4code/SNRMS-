# ==== Copy this file to .env.prod and fill in real values ====

# Your domain (must already point to this server's IP via an A record)
DOMAIN=snrms.yourdomain.com

# Django
SECRET_KEY=CHANGE-ME-to-a-long-random-string-min-50-chars
DEBUG=False
ALLOWED_HOSTS=snrms.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://snrms.yourdomain.com
SECURE_SSL_REDIRECT=True

# Database (used by both the db service and Django)
DB_NAME=snrms
DB_USER=snrms
DB_PASSWORD=CHANGE-ME-strong-database-password
DB_HOST=db
DB_PORT=5432

# Paystack — use TEST keys first, switch to LIVE keys when ready
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
PAYMENT_CALLBACK_URL=https://snrms.yourdomain.com

# Email via SendGrid — carries registration codes, password resets and workflow
# notices. Create the key at Settings > API Keys with "Mail Send" access only.
# DEFAULT_FROM_EMAIL must be an address SendGrid has verified (Sender Identity
# or authenticated domain), or every message is rejected.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=SNRMS Ibeju-Lekki <admin@snrms.com>

# Leave SENDGRID_API_KEY blank to fall back to plain SMTP instead:
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
