# ==== Copy this file to .env.prod and fill in real values ====

# Your domain (must already point to this server's IP via an A record)
DOMAIN=snrms.yourdomain.com

# Django
SECRET_KEY=CHANGE-ME-to-a-long-random-string-min-50-chars
DEBUG=False
ALLOWED_HOSTS=snrms.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://snrms.yourdomain.com
SECURE_SSL_REDIRECT=True

# Database (used by both the db service and Django)
DB_NAME=snrms
DB_USER=snrms
DB_PASSWORD=CHANGE-ME-strong-database-password
DB_HOST=db
DB_PORT=5432

# Paystack — use TEST keys first, switch to LIVE keys when ready
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
PAYMENT_CALLBACK_URL=https://snrms.yourdomain.com
